# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca lo subas al repositorio.

# Proveedor LLM por defecto (LLM_PROVIDER = "gemini" en linkedin_agent.py).
# API key de Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Solo necesaria si cambias LLM_PROVIDER a "claude".
# API key de Anthropic: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Token de Apify: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
